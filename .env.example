# Local development defaults for the Docker stack (docker compose up).
# Real secrets never go in this file or the repo; staging and production read them from the secrets manager.

APP_NAME=FanFolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

OCTANE_SERVER=swoole

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_READ_HOSTS=postgres
DB_PORT=5432
DB_DATABASE=fanfolio
DB_USERNAME=fanfolio
DB_PASSWORD=fanfolio-local-only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# S3-compatible stand-in for Cloudflare R2 (MinIO in Docker).
R2_ENDPOINT=http://minio:9000
R2_ACCESS_KEY_ID=fanfolio
R2_SECRET_ACCESS_KEY=fanfolio-local-only
R2_REGION=auto

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Placeholders from CLAUDE.md open decisions. Do not invent values.
FANFOLIO_DOMAIN="[domain]"
FANFOLIO_PRIVACY_EMAIL="privacy@[domain]"

# Gateway drivers: only "fake" exists until providers are chosen.
FANFOLIO_TOPUP_DRIVER=fake
FANFOLIO_PAYOUT_BANK_DRIVER=fake
FANFOLIO_PAYOUT_USDT_DRIVER=fake
FANFOLIO_PAYOUT_PAXUM_DRIVER=fake
FANFOLIO_FX_DRIVER=fake
FANFOLIO_KYC_DRIVER=fake
FANFOLIO_SMS_DRIVER=fake
FANFOLIO_BREACHED_PASSWORDS_DRIVER=fake
FANFOLIO_DRM_DRIVER=fake
FANFOLIO_MALWARE_DRIVER=fake
FANFOLIO_ABUSE_HASH_DRIVER=fake
FANFOLIO_CLASSIFIER_DRIVER=fake
FANFOLIO_LEAK_CRAWLER_DRIVER=fake
# pass | fail | review | underage | fraud
FANFOLIO_FAKE_KYC_OUTCOME=pass

VITE_APP_NAME="${APP_NAME}"

# /admin panel (SEC-15). Empty allow-list = closed outside local/testing.
FANFOLIO_ADMIN_IP_ALLOWLIST=
FANFOLIO_ADMIN_SSO_REQUIRED=false
